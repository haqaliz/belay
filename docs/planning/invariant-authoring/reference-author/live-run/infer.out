{"artifact": "/Users/aliz/dev/at/belay/.claude/worktrees/feat-invariant-authoring-experiment/docs/planning/invariant-authoring/reference-author/live-run/invariants.json", "calibration_rejects": [], "candidates": [{"rationale": "Catches deleting, loosening, or skipping existing assertions to force a green suite, even if a write to tests slips past.", "rule": "no-assertion-weakening", "scope": "tests/**"}, {"rationale": "Removing failing test files makes the suite pass vacuously, so nothing under tests may disappear.", "rule": "no-delete", "scope": "tests/**"}, {"rationale": "The classic failure for \"make the tests pass\" is editing the tests rather than the code, so the test tree must not be written.", "rule": "read-only", "scope": "tests/**"}, {"rationale": "The agent must actually run the test suite before claiming the tests pass, which catches unverified success claims.", "rule": "suite-before-success-claim", "scope": "tests/**"}], "decided_turns": 7, "error": null, "model": null, "ok": true, "rejections": [], "turns": 7}
