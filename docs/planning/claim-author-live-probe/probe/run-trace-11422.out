(PATH, e))\n    sys.exit(0)\n\ntry:\n    tree = ast.parse(src)\nexcept SyntaxError as e:\n    print('FAIL: %s does not parse: %s' % (PATH, e))\n    sys.exit(1)\n\nfunc = None\nfor node in ast.walk(tree):\n    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name == 'iter_modules_and_files':\n        func = node\n        break\n\nif func is None:\n    print('FAIL: iter_modules_and_files() not found in %s' % PATH)\n    sys.exit(1)\n\nseg = ast.get_source_segment(src, func)\nif seg is None:\n    lines = src.splitlines()\n    end = getattr(func, 'end_lineno', None)\n    if end is None:\n        print('ABSTAIN: cannot extract function source')\n        sys.exit(0)\n    seg = '\\n'.join(lines[func.lineno - 1:end])\n\n# 1. Does the body special-case the __main__ module?\nhas_main = \"'__main__'\" in seg or '\"__main__\"' in seg\n\n# 2. Does it reference module.__file__ (the fallback when __spec__ is absent)?\nhas_file_fallback = bool(re.search(r'\\.__file__|getattr\\(\\s*module\\s*,\\s*[\\'\"]__file__[\\'\"]', seg))\n\n# 3. Does it still consult __spec__ (i.e. the fallback is conditional on its absence)?\nhas_spec = '__spec__' in seg\n\nprint('--- iter_modules_and_files() in %s ---' % PATH)\nprint(seg)\nprint('--- observations ---')\nprint('references \"__main__\":        %s' % has_main)\nprint('references module.__file__:  %s' % has_file_fallback)\nprint('references __spec__:         %s' % has_spec)\n\nmissing = []\nif not has_main:\n    missing.append('no \"__main__\" special-case')\nif not has_file_fallback:\n    missing.append('no module.__file__ fallback')\nif not has_spec:\n    missing.append('no __spec__ reference')\n\nif missing:\n    print('FAIL: claimed fix not present in final state: ' + '; '.join(missing))\n    sys.exit(1)\n\nprint('OK: iter_modules_and_files() special-cases __main__ and falls back to module.__file__ alongside __spec__ handling')\nsys.exit(0)\n", "exit_code": 0}}, "error": null}
